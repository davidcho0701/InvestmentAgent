# ============================================
# InvestScope 환경변수 템플릿
# 복사: cp .env.example .env  (Windows: copy .env.example .env)
# ============================================

# --- DART (전자공시) ---
# 발급: https://opendart.fss.or.kr/
DART_API_KEY=

# --- ECOS (한국은행 경제통계) ---
# 발급: https://ecos.bok.or.kr/api/
ECOS_API_KEY=

# --- 네이버 뉴스 검색 API ---
# 발급: https://developers.naver.com/apps/
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- KIS Developers (한국투자증권) ---
# 발급: https://apiportal.koreainvestment.com/
# 주의: 시세/투자의견 조회 전용. 주문(order) 엔드포인트는 사용하지 않는다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_IS_MOCK=false

# --- DB / Cache ---
# Supabase: https://supabase.com/  (Project Settings > Database > Connection string)
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Upstash: https://upstash.com/  (Redis > REST/TCP endpoint)
REDIS_URL=redis://default:password@host:6379

# --- LLM (고영향 뉴스 근거 · 차트 해설 생성 전용) ---
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- 앱 설정 ---
MAX_WATCHLIST_SLOTS=3
SNAPSHOT_CACHE_TTL_SECONDS=21600
NEWS_POLL_INTERVAL_MINUTES=10

# --- 프론트엔드 (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
